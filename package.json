{
  "name": "virtual-story",
  "version": "1.0.0",
  "description": "Virtual Story interactive video app",
  "productName": "Virtual Story",
  "author": {
    "name": "Martial Limousin",
    "email": "martial.limousin@gmail.com"
  },
  "homepage": "https://github.com/neomars/virtual-story",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:linux": "electron-builder --linux --publish never",
    "build:win": "electron-builder --windows",
    "build:frontend": "npm --prefix frontend run build",
    "build:engine": "cargo build --release --manifest-path live-engine/Cargo.toml",
    "build:sidecars": "bash scripts/build-sidecars.sh",
    "dist:linux": "bash scripts/build-linux.sh",
    "doctor": "bash scripts/doctor.sh",
    "pack:linux": "bash scripts/build-linux.sh --dir"
  },
  "build": {
    "appId": "com.virtualstory.app",
    "productName": "Virtual Story",
    "executableName": "virtual-story",
    "artifactName": "virtual-story-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "package.json",
      "backend/**/*",
      "!backend/node_modules{,/**}",
      "!backend/uploads{,/**}",
      "!backend/db.json",
      "!backend/.env*",
      "!backend/*.py",
      "!backend/*lock*",
      "frontend/dist/**/*"
    ],
    "extraResources": [
      {
        "from": "live-engine/target/release/live-engine",
        "to": "engine/live-engine"
      },
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*",
          "!.gitkeep"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo",
      "maintainer": "Martial Limousin <martial.limousin@gmail.com>",
      "synopsis": "Vidéo interactive et conversation IA locale",
      "description": "Histoires vidéo interactives et conversation avec une IA locale (texte, voix, médiathèque) sur GPU NVIDIA."
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libgomp1",
        "libssl3 | libssl3t64"
      ],
      "recommends": [
        "nvidia-driver-550 | nvidia-driver"
      ]
    },
    "win": {
      "target": "nsis"
    },
    "npmRebuild": false
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "alasql": "^4.17.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.19.0",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.1.0",
    "multer": "^2.0.2"
  }
}
