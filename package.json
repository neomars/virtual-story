{
  "name": "virtual-story",
  "version": "1.0.0",
  "description": "Virtual Story interactive video app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --windows",
    "build:frontend": "npm --prefix frontend run build",
    "build:engine": "cargo build --release --manifest-path live-engine/Cargo.toml",
    "build:sidecars": "bash scripts/build-sidecars.sh",
    "dist:linux": "bash scripts/build-linux.sh"
  },
  "build": {
    "appId": "com.virtualstory.app",
    "productName": "Virtual Story",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "backend/**/*",
      "frontend/dist/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "maintainer": "Virtual Story"
    },
    "win": {
      "target": "nsis"
    },
    "extraResources": [
      {
        "from": "live-engine/target/release/live-engine",
        "to": "engine/live-engine"
      },
      {
        "from": "bin",
        "to": "bin"
      }
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ],
      "recommends": [
        "nvidia-driver-550 | nvidia-driver"
      ]
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "alasql": "^4.17.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.19.0",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.1.0",
    "multer": "^2.0.2"
  }
}
